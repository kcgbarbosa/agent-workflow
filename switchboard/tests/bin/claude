#!/usr/bin/env python3
"""A stand-in for `claude -p` in stream-json mode. It echoes each message back as the answer.

A message with "slow" waits two seconds before it answers. A message with "inbound" first plays a turn that a
message from another session woke, the way the real session does when a reply arrives while it is idle.
"""

import json
import sys
import time


def emit(event: dict[str, object]) -> None:
    print(json.dumps(event), flush=True)


def turn(user: str, answer: str) -> None:
    emit({"type": "user", "message": {"role": "user", "content": user}, "isReplay": True})
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": answer}]}})
    emit({"type": "result", "subtype": "success"})


emit({"type": "system", "subtype": "init", "session_id": "fake-session"})
for line in sys.stdin:
    content = json.loads(line)["message"]["content"]
    if "inbound" in content:
        turn("Another Claude session sent a message: done", "PITCH-16 says the tests pass.")
    if "slow" in content:
        time.sleep(2)
    turn(content, "**echo** " + content.split("] ", 1)[1])
