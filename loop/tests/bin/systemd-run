#!/usr/bin/env python3
"""A fake `systemd-run --user` for the loop tests. It starts the command as a process of its own and returns,
as `--service-type=exec` does once the command runs. FAKE_CLAUDE_DIR/units/<unit>.json keeps the unit with
its pid, and the unit counts as loaded while the process lives, as `--collect` unloads a unit that ended, also
a failed one. The process gets only the `--setenv` variables and the test's own `FAKE_` and `GIT_CONFIG_`
ones. `python -m loop` runs through loop_clock.py, as in the scenario tests. A `loop watch` unit starts no
process and stays active. Each call goes to systemd.jsonl.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

fakes = Path(os.environ["FAKE_CLAUDE_DIR"])
args = sys.argv[1:]
with (fakes / "systemd.jsonl").open("a") as calls:
    calls.write(json.dumps({"tool": "systemd-run", "args": args}) + "\n")
options = []
while args and args[0].startswith("-"):
    options.append(args.pop(0))
values = {option.split("=", 1)[0]: option.split("=", 1)[1] for option in options if "=" in option}
unit = values["--unit"]
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from fake_units import UNITS as units  # noqa: E402
from fake_units import alive  # noqa: E402

units.mkdir(exist_ok=True)
state = units / f"{unit}.json"

if alive(unit):
    print(f"Failed to start transient service unit: Unit {unit} was already loaded.", file=sys.stderr)
    sys.exit(1)
if args[1:4] == ["-m", "loop", "watch"]:
    state.write_text(json.dumps({"pid": None, "args": args}))
    sys.exit(0)
if args[1:3] == ["-m", "loop"]:
    args = [args[0], str(Path(__file__).resolve().parent.parent / "loop_clock.py"), *args[3:]]
env = {name: value for name, value in os.environ.items() if name.startswith(("FAKE_", "GIT_CONFIG_"))}
env.update(option.removeprefix("--setenv=").split("=", 1) for option in options if option.startswith("--setenv="))
with (units / f"{unit}.log").open("a") as log:
    process = subprocess.Popen(
        args, cwd=values["--working-directory"], env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
        start_new_session=True,
    )
state.write_text(json.dumps({"pid": process.pid, "args": args}))
