#!/usr/bin/env python3
"""A fake GitHub CLI for the loop tests. It records each call, and keeps each PR it creates.

The PRs live in FAKE_CLAUDE_DIR/prs.json, so `gh pr list --head <branch>` finds the open PR of a branch, and
`gh pr edit` and `gh pr ready` change it. A test merges a PR in the file: its `state` is `merged`, and its
`merge_commit` names the commit. `--state all` lists a PR in any state, and `--json` with no `--jq` prints the
PRs as GitHub does. After its change, a call reaches the kill point `gh:<command>`.
"""

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from killpoint import reached  # noqa: E402

args = sys.argv[1:]
fakes = Path(os.environ["FAKE_CLAUDE_DIR"])
body = Path(args[args.index("--body-file") + 1]).read_text() if "--body-file" in args else None
with (fakes / "gh.jsonl").open("a") as calls:
    calls.write(json.dumps({"args": args, "body": body}) + "\n")

store = fakes / "prs.json"
prs = json.loads(store.read_text()) if store.exists() else []


def value(flag: str) -> str:
    return args[args.index(flag) + 1]


if args[:2] == ["pr", "list"]:
    state = value("--state") if "--state" in args else "open"
    found = [pr for pr in prs if pr["head"] == value("--head") and state in (pr["state"], "all")]
    if "--json" in args and "--jq" not in args:
        github = {
            "url": lambda pr: pr["url"],
            "state": lambda pr: pr["state"].upper(),
            "mergeCommit": lambda pr: {"oid": pr["merge_commit"]} if pr.get("merge_commit") else None,
        }
        fields = value("--json").split(",")
        print(json.dumps([{name: github[name](pr) for name in fields} for pr in found]))
    else:
        for pr in found:
            print(pr["url"])
elif args[:2] == ["pr", "create"]:
    url = f"https://github.com/kcgbarbosa/demo/pull/{99 + len(prs)}"
    pr = {"url": url, "head": value("--head"), "base": value("--base"), "title": value("--title")}
    prs.append({**pr, "body": body, "draft": "--draft" in args, "state": "open"})
    print(url)
elif args[:2] == ["pr", "edit"]:
    next(pr for pr in prs if pr["url"] == args[2])["body"] = body
elif args[:2] == ["pr", "ready"]:
    next(pr for pr in prs if pr["url"] == args[2])["draft"] = "--undo" in args
store.write_text(json.dumps(prs))
reached(f"gh:{' '.join(args[:2])}")
