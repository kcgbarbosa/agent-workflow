#!/usr/bin/env python3
"""A fake `claude -p` for the loop tests. It never calls a model.

FAKE_CLAUDE_DIR/plan.json maps a session name (`-n`) to a list of steps. Each call takes the next step.
A step can write and delete files and commit them, write files with `uncommitted` and not commit them, save
a screenshot or a PR body in LOOP_RUN_DIR, make `trials` worktrees as a trial subagent leaves them, return a status and review findings, or fail with a usage limit
or a crash after its commit. A usage limit with `resets_in` reports when it resets, in seconds from now. A step with `late_turn` adds a second result with no status, as when a background subagent wakes the
session after its status. A step with `peek` saves what the agent logs in LOOP_RUN_DIR hold while it runs to
FAKE_CLAUDE_DIR/peek.json. With no step left, the call returns done and changes nothing. `--version` prints
FAKE_CLAUDE_VERSION, or a version new enough for the loop.

The output is stream-json: one event per line, with one result event per turn. Each result event reports a
cost, and the late turn reports a higher one, as the session's cost grows.
"""

import json
import os
import subprocess
import sys
import time
import uuid
from pathlib import Path

args = sys.argv[1:]
if "--version" in args:
    print(f"{os.environ.get('FAKE_CLAUDE_VERSION', '2.1.295')} (Claude Code)")
    sys.exit(0)
prompt = args[args.index("-p") + 1]
name = args[args.index("-n") + 1]
resume = args[args.index("--resume") + 1] if "--resume" in args else None
home = Path(os.environ["FAKE_CLAUDE_DIR"])

with (home / "calls.jsonl").open("a") as calls:
    record = {
        "name": name,
        "prompt": prompt,
        "resume": resume,
        "cwd": os.getcwd(),
        "secret": os.environ.get("JIRA_API_TOKEN"),
        "bw_session": os.environ.get("BW_SESSION"),
        "db_port": os.environ.get("DB_PORT"),
        "run_dir": os.environ.get("LOOP_RUN_DIR"),
        "schema": json.loads(args[args.index("--json-schema") + 1]),
        "model": args[args.index("--model") + 1] if "--model" in args else None,
        "effort": args[args.index("--effort") + 1] if "--effort" in args else None,
        "mcp_config": args[args.index("--mcp-config") + 1] if "--mcp-config" in args else None,
        "agents": args[args.index("--agents") + 1] if "--agents" in args else None,
        "system_prompt": args[args.index("--append-system-prompt") + 1] if "--append-system-prompt" in args else None,
        "settings": json.loads(args[args.index("--settings") + 1]) if "--settings" in args else None,
    }
    calls.write(json.dumps(record) + "\n")

plan = json.loads((home / "plan.json").read_text()).get(name, [])
counter = home / f"count-{name}"
number = int(counter.read_text()) if counter.exists() else 0
counter.write_text(str(number + 1))
step = plan[number] if number < len(plan) else {}
session = resume or str(uuid.uuid4())

for path, content in step.get("write", {}).items():
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text(content)
for path in step.get("delete", []):
    Path(path).unlink()
if step.get("write") or step.get("delete"):
    subprocess.run(["git", "add", "-A"], check=True)
    message = step.get("commit", f"feat({name}): change")
    subprocess.run(["git", "commit", "-q", "-m", message], check=True)
for trial in step.get("trials", []):
    # A trial subagent's worktree, as Claude Code makes it: in the main checkout, from HEAD or from main.
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True, check=True)
    path = Path(common.stdout.strip()).parent / ".claude" / "worktrees" / f"agent-{trial['name']}"
    base = "origin/main" if trial.get("from_main") else "HEAD"
    subprocess.run(["git", "worktree", "add", "-q", "-b", f"worktree-agent-{trial['name']}", str(path), base], check=True)
    (path / "trial.txt").write_text("a change the trial left")
    if trial.get("locked"):
        subprocess.run(["git", "worktree", "lock", str(path)], check=True)
for path, content in step.get("uncommitted", {}).items():
    Path(path).write_text(content)
if step.get("pr_body"):
    Path(os.environ["LOOP_RUN_DIR"], "pr-body.md").write_text(step["pr_body"])
if step.get("screenshot"):
    Path(os.environ["LOOP_RUN_DIR"], "home-360-chromium-en.png").write_bytes(b"\x89PNG fake")

print(json.dumps({"type": "system", "subtype": "init", "session_id": session}), flush=True)
if step.get("peek"):
    print("Starting the MCP servers", file=sys.stderr, flush=True)
    logs = {log.name: log.read_text() for log in Path(os.environ["LOOP_RUN_DIR"]).glob("agent-*")}
    (home / "peek.json").write_text(json.dumps(logs))
if step.get("error") == "usage":
    if "resets_in" in step:
        info = {"status": "rejected", "resetsAt": int(time.time()) + step["resets_in"], "rateLimitType": "five_hour"}
        print(json.dumps({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session}))
    print(json.dumps({"type": "result", "is_error": True, "result": "Claude usage limit reached", "session_id": session}))
    sys.exit(1)
if step.get("error") == "crash":
    print("Segmentation fault", file=sys.stderr)
    sys.exit(139)


def cost(dollars: float, turns: int) -> dict[str, object]:
    models = {
        "claude-opus-5-5": {"inputTokens": 10, "outputTokens": 20, "costUSD": round(dollars - 0.01, 2), "contextWindow": 1000000},
        "claude-sonnet-5-5": {"inputTokens": 30, "outputTokens": 40, "costUSD": 0.01, "costBasis": "list"},
    }
    stats = {"spawned": 1, "by_type": {"runner": 1}}
    return {"total_cost_usd": dollars, "num_turns": turns, "duration_ms": 1000 * turns, "modelUsage": models, "subagent_stats": stats}


output = {"status": step.get("status", "done"), "reason": step.get("reason", ""), "decisions": step.get("decisions", [])}
if "findings" in record["schema"]["properties"]:
    output["findings"] = step.get("findings", [])
print(json.dumps({"type": "result", "is_error": False, "session_id": session, "result": "", "structured_output": output, **cost(0.5, 3)}))
if step.get("late_turn"):
    print(json.dumps({"type": "result", "is_error": False, "session_id": session, "result": "The reviews are applied.", **cost(0.75, 4)}))
