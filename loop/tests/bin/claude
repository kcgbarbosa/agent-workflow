#!/usr/bin/env python3
"""A fake `claude -p` for the loop tests. It never calls a model.

FAKE_CLAUDE_DIR/plan.json maps a session name (`-n`) to a list of steps. Each call takes the next step. A step
can write and delete files and commit them, write files with `uncommitted` and not commit them, save a
screenshot or a PR body in LOOP_RUN_DIR, make `trials` worktrees as a trial subagent leaves them, return a
status and review findings, or fail with a usage limit or a crash after its commit. A usage limit with
`resets_in` reports when it resets, in seconds from now. A step with `linger` keeps the process open that many
seconds after its last result. A step with `child` starts a process that sleeps ten minutes, and writes its
pid to FAKE_CLAUDE_DIR/agent-child.pid. A step with `late_turn` adds a second result with no status, as a
later turn can. A step with `rate_limits` writes one `rate_limit_event` per item, with the utilization and the
reset of each window, as the CLI writes the plan meter. A step with `messages` writes the assistant messages
with their usage, one event per content block as the CLI does, and a message with `parent` comes from a
subagent. A step with `peek` saves what the agent logs in LOOP_RUN_DIR hold while it runs to
FAKE_CLAUDE_DIR/peek.json. A step with `stall` goes quiet for that many seconds in the middle of its turn,
after its plan meter. A step with `split` writes each event in two parts, so a reader can meet a cut-off line.
A step with `error` "mid-turn" stops in the middle of its turn, after part of a line and with no result. After
its files, a call reaches the kill point `claude:<name>`, and a call that returns its status goes to
FAKE_CLAUDE_DIR/finished.jsonl. With no step left, the call returns done and changes nothing. `--version`
prints FAKE_CLAUDE_VERSION, or a version new enough for the loop.

The output is stream-json: one event per line, with one result event per turn. Each result event reports a
cost, and the late turn reports a higher one, as the session's cost grows.
"""

import json
import os
import subprocess
import sys
import time
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from killpoint import reached  # noqa: E402

args = sys.argv[1:]
if "--version" in args:
    print(f"{os.environ.get('FAKE_CLAUDE_VERSION', '2.1.301')} (Claude Code)")
    sys.exit(0)
prompt = args[args.index("-p") + 1]
name = args[args.index("-n") + 1]
resume = args[args.index("--resume") + 1] if "--resume" in args else None
home = Path(os.environ["FAKE_CLAUDE_DIR"])

with (home / "calls.jsonl").open("a") as calls:
    record = {
        "name": name,
        "prompt": prompt,
        "resume": resume,
        "cwd": os.getcwd(),
        "secret": os.environ.get("JIRA_API_TOKEN"),
        "bw_session": os.environ.get("BW_SESSION"),
        "db_port": os.environ.get("DB_PORT"),
        "run_dir": os.environ.get("LOOP_RUN_DIR"),
        "no_background": os.environ.get("CLAUDE_CODE_DISABLE_BACKGROUND_TASKS"),
        "schema": json.loads(args[args.index("--json-schema") + 1]),
        "model": args[args.index("--model") + 1] if "--model" in args else None,
        "effort": args[args.index("--effort") + 1] if "--effort" in args else None,
    }
    calls.write(json.dumps(record) + "\n")

plan = json.loads((home / "plan.json").read_text()).get(name, [])
counter = home / f"count-{name}"
number = int(counter.read_text()) if counter.exists() else 0
counter.write_text(str(number + 1))
step = plan[number] if number < len(plan) else {}
session = resume or str(uuid.uuid4())

for path, content in step.get("write", {}).items():
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text(content)
for path in step.get("delete", []):
    Path(path).unlink()
if step.get("write") or step.get("delete"):
    subprocess.run(["git", "add", "-A"], check=True)
    message = step.get("commit", f"feat({name}): change")
    subprocess.run(["git", "commit", "-q", "-m", message], check=True)
for trial in step.get("trials", []):
    # A trial subagent's worktree, as Claude Code makes it: in the main checkout, from HEAD or from main.
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True, check=True)
    path = Path(common.stdout.strip()).parent / ".claude" / "worktrees" / f"agent-{trial['name']}"
    base = "origin/main" if trial.get("from_main") else "HEAD"
    subprocess.run(["git", "worktree", "add", "-q", "-b", f"worktree-agent-{trial['name']}", str(path), base], check=True)
    (path / "trial.txt").write_text("a change the trial left")
    if trial.get("locked"):
        subprocess.run(["git", "worktree", "lock", str(path)], check=True)
for path, content in step.get("uncommitted", {}).items():
    Path(path).write_text(content)
if step.get("pr_body"):
    Path(os.environ["LOOP_RUN_DIR"], "pr-body.md").write_text(step["pr_body"])
if step.get("child"):
    # A process the session started, such as a dev server, that would run for ten minutes.
    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(600)"])
    (home / "agent-child.pid").write_text(str(child.pid))
if step.get("screenshot"):
    Path(os.environ["LOOP_RUN_DIR"], "home-360-chromium-en.png").write_bytes(b"\x89PNG fake")
reached(f"claude:{name}")


def emit(event: dict[str, object]) -> None:
    line = json.dumps(event) + "\n"
    if step.get("split"):
        half = len(line) // 2
        sys.stdout.write(line[:half])
        sys.stdout.flush()
        time.sleep(0.05)
        line = line[half:]
    sys.stdout.write(line)
    sys.stdout.flush()


emit({"type": "system", "subtype": "init", "session_id": session})
if step.get("peek"):
    print("Starting the MCP servers", file=sys.stderr, flush=True)
    logs = {log.name: log.read_text() for log in Path(os.environ["LOOP_RUN_DIR"]).glob("agent-*")}
    (home / "peek.json").write_text(json.dumps(logs))
for meter in step.get("rate_limits", []):
    windows = {window: {"utilization": value, "resetsAt": resets} for window, (value, resets) in meter.items()}
    first = next(iter(windows))
    info = {"status": "allowed", "rateLimitType": first, **windows[first], "unifiedWindows": windows}
    emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session})
if step.get("stall"):
    time.sleep(step["stall"])
for message in step.get("messages", []):
    fresh, read, written = message["context"]
    usage = {"input_tokens": fresh, "cache_read_input_tokens": read, "cache_creation_input_tokens": written, "output_tokens": 5}
    for _ in range(message.get("blocks", 1)):
        body = {"id": message["id"], "role": "assistant", "content": [{"type": "text", "text": "Working."}], "usage": usage}
        emit({"type": "assistant", "message": body, "parent_tool_use_id": message.get("parent"), "session_id": session})
if step.get("error") == "mid-turn":
    sys.stdout.write(json.dumps({"type": "assistant", "session_id": session})[:20])
    sys.stdout.flush()
    sys.exit(1)
if step.get("error") == "usage":
    if "resets_in" in step:
        info = {"status": "rejected", "resetsAt": int(time.time()) + step["resets_in"], "rateLimitType": "five_hour"}
        emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session})
    emit({"type": "result", "is_error": True, "result": "Claude usage limit reached", "session_id": session})
    sys.exit(1)
if step.get("error") == "crash":
    print("Segmentation fault", file=sys.stderr)
    sys.exit(139)


def cost(dollars: float, turns: int) -> dict[str, object]:
    models = {
        "claude-opus-5-5": {"inputTokens": 10, "outputTokens": 20, "costUSD": round(dollars - 0.01, 2), "contextWindow": 1000000},
        "claude-sonnet-5-5": {"inputTokens": 30, "outputTokens": 40, "costUSD": 0.01, "costBasis": "list"},
    }
    stats = {"spawned": 1, "by_type": {"runner": 1}}
    return {"total_cost_usd": dollars, "num_turns": turns, "duration_ms": 1000 * turns, "modelUsage": models, "subagent_stats": stats}


output = {"status": step.get("status", "done"), "reason": step.get("reason", ""), "decisions": step.get("decisions", [])}
if step.get("notes"):
    output["notes"] = step["notes"]
if "findings" in record["schema"]["properties"]:
    output["findings"] = step.get("findings", [])
    output["unchecked"] = step.get("unchecked", [])
emit({"type": "result", "is_error": False, "session_id": session, "result": "", "structured_output": output, **cost(0.5, 3)})
if step.get("late_turn"):
    emit({"type": "result", "is_error": False, "session_id": session, "result": "The reviews are applied.", **cost(0.75, 4)})
with (home / "finished.jsonl").open("a") as finished:
    finished.write(json.dumps({"name": name}) + "\n")
if step.get("linger"):
    sys.stdout.flush()
    time.sleep(step["linger"])
