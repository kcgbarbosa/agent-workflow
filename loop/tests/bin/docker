#!/usr/bin/env python3
"""A fake Docker CLI for the loop tests. It records each call and starts no container.

`compose ls` prints FAKE_CLAUDE_DIR/compose-projects.json, or no project. `compose run` sets up the
controlling terminal when it has one, as the real one does, and a process group in the background of that
terminal stops there. Each call also goes to commands.jsonl, which keeps the order of the Docker and `make`
calls.
"""

import json
import os
import sys
import termios
from pathlib import Path

fakes = Path(os.environ["FAKE_CLAUDE_DIR"])
record = {"args": sys.argv[1:], "project": os.environ.get("COMPOSE_PROJECT_NAME"), "terminal": False}
if sys.argv[1:3] == ["compose", "run"]:
    try:
        terminal = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        pass
    else:
        termios.tcsetattr(terminal, termios.TCSANOW, termios.tcgetattr(terminal))
        record["terminal"] = True
for name in ("docker.jsonl", "commands.jsonl"):
    with (fakes / name).open("a") as calls:
        calls.write(json.dumps({**record, "tool": "docker"}) + "\n")

if sys.argv[1:3] == ["compose", "ls"]:
    projects = fakes / "compose-projects.json"
    print(projects.read_text() if projects.exists() else "[]")
