#!/usr/bin/env python3
"""A fake `systemctl --user` for the loop tests, over the units of the fake `systemd-run`. `list-units` lists the
loaded units that match the pattern, `is-active` answers for each unit named, `stop` sends SIGTERM to the
unit's process and waits for it to end, as KillMode=mixed does, and `restart` does nothing. Each call goes to
systemd.jsonl.
"""

import fnmatch
import json
import os
import signal
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from fake_units import UNITS as units  # noqa: E402
from fake_units import alive  # noqa: E402

fakes = Path(os.environ["FAKE_CLAUDE_DIR"])
args = sys.argv[2:]
with (fakes / "systemd.jsonl").open("a") as calls:
    calls.write(json.dumps({"tool": "systemctl", "args": args}) + "\n")
command = args[0]
names = sorted(path.stem for path in units.glob("*.json")) if units.is_dir() else []
if command == "list-units":
    for name in names:
        if alive(name) and fnmatch.fnmatch(name, args[-1]):
            print(f"{name} loaded active running {name}")
elif command == "is-active":
    states = [alive(name) for name in args[1:]]
    print("\n".join("active" if state else "inactive" for state in states))
    sys.exit(0 if any(states) else 3)
elif command == "stop" and alive(args[1]):
    state = units / f"{args[1]}.json"
    pid = json.loads(state.read_text())["pid"]
    if pid is None:
        state.unlink()
    else:
        os.kill(pid, signal.SIGTERM)
    while alive(args[1]):
        time.sleep(0.1)
