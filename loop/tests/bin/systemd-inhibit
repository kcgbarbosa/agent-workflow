#!/usr/bin/env python3
"""A fake `systemd-inhibit` for the loop tests. It holds off no sleep, and runs until the `--pid` process ends."""

import os
import sys
import time

pid = int(next(arg for arg in sys.argv if arg.startswith("--pid=")).removeprefix("--pid="))
while True:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        break
    time.sleep(0.2)
